{
  "name": "contractor-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma db execute --file prisma/check-connection.sql --schema prisma/schema.prisma",
    "db:studio": "prisma studio",
    "recommendations:refresh": "node scripts/refresh-recommendations.mjs",
    "test:recommendations": "node scripts/test-recommendations.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.8.0",
