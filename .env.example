# Local Docker database (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/contractor_marketplace?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"

# Required in production for legal notices and customer support
LEGAL_ENTITY_NAME="Your Legal Entity LLC"
LEGAL_ADDRESS="123 Main Street, City, ST 00000"
SUPPORT_EMAIL="support@example.com"
GOVERNING_STATE="Your State"
MINIMUM_AGE="18"
# Set on non-Vercel production hosts to fail startup when legal identity is incomplete.
ENFORCE_LEGAL_CONFIG="false"

# Google Gemini (optional; heuristic extraction is used when unset)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Optional Upstash Redis REST cache for recommendation responses
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Vercel Blob (Storage → Blob → create store; pull with `vercel env pull`)
# Required for job/profile image uploads. Create the store as Public so <img> URLs work.
BLOB_READ_WRITE_TOKEN=""

